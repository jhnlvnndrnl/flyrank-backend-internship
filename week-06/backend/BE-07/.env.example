# Environment variables — copy to .env and fill in real values
# Three variables control which LLM provider you talk to:
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your-openrouter-api-key-here
LLM_MODEL=openrouter/auto

# Stub mode: set to 1 to skip model calls entirely (returns hard-coded response)
LLM_STUB=0

# Kill switch: set to false to disable LLM and return a deterministic fallback
LLM_ENABLED=true

# Server port
PORT=8000
